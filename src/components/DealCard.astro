---
import { outUrl } from '../data/merchants';
import type { Deal } from '../data/deals';

interface Props {
  deal: Deal;
}

const { deal } = Astro.props;
const href = outUrl(deal.merchantId);
---

<article class="brutal-card deal-card">
  <div class="deal-top">
    <span class="deal-merchant">{deal.merchantLabel}</span>
    {deal.badge && <span class="deal-badge">{deal.badge}</span>}
  </div>

  <h3 class="deal-title">{deal.title}</h3>
  <p class="deal-detail">{deal.detail}</p>

  <div class="deal-price-row">
    <span class="deal-price">{deal.price}</span>
    {deal.compareAt && <span class="deal-compare">{deal.compareAt}</span>}
    {deal.code && <span class="deal-code">Code: {deal.code}</span>}
  </div>

  <div class="deal-foot">
    <span class="deal-meta">
      Checked {deal.checked}{deal.expires ? ` · Ends ${deal.expires}` : ''}
    </span>
    <a
      class="brutal-btn deal-btn"
      href={href}
      target="_blank"
      rel="noopener nofollow"
      aria-label={`Get this deal at ${deal.merchantLabel} (opens in a new tab)`}
    >
      Get this deal at {deal.merchantLabel} →
    </a>
  </div>
</article>

<style>
  .deal-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
  }

  .deal-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .deal-merchant {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.5rem;
    background: var(--color-primary);
    color: #fff;
  }

  .deal-badge {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.5rem;
    border: 2px solid var(--color-cta);
    color: var(--color-cta);
  }

  .deal-title {
    font-size: 1.15rem;
    margin: 0;
  }

  .deal-detail {
    font-size: 0.9rem;
    margin: 0;
    flex: 1;
  }

  .deal-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .deal-price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-cta);
  }

  .deal-compare {
    font-size: 0.85rem;
    opacity: 0.6;
    text-decoration: line-through;
  }

  .deal-code {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border: 2px dashed var(--color-cta);
    color: var(--color-cta);
  }

  .deal-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    border-top: 2px solid var(--color-surface);
    padding-top: 0.75rem;
    margin-top: 0.25rem;
  }

  .deal-meta {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .deal-btn {
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
    white-space: nowrap;
  }
</style>
