---
import { NEWSLETTER } from '../config';
---

<div class="nl-wrap">
  <div class="nl-embed">
    <script
      async
      src={NEWSLETTER.loaderSrc}
      data-beehiiv-form={NEWSLETTER.formId}
      is:inline></script>
  </div>
  <noscript>
    <p class="nl-note">
      JavaScript off? No problem —{' '}
      <a href={NEWSLETTER.subscribePage} target="_blank" rel="noopener noreferrer">
        subscribe on our beehiiv page
      </a>.
    </p>
  </noscript>

  {/* beehiiv injiziert ein <iframe> ohne title — Lighthouse meldet das als
      A11y-Fehler (frame-title). Nachziehen, sobald der Loader das Element baut. */}
  <script is:inline>
    (function () {
      function label() {
        var frames = document.querySelectorAll('.nl-embed iframe');
        for (var i = 0; i < frames.length; i++) {
          if (!frames[i].getAttribute('title')) {
            frames[i].setAttribute('title', 'FKN Wine newsletter signup');
          }
        }
      }
      label();
      var host = document.querySelector('.nl-embed');
      if (host && window.MutationObserver) {
        new MutationObserver(label).observe(host, { childList: true, subtree: true });
      }
      window.addEventListener('load', label);
      setTimeout(label, 1500);
    })();
  </script>
</div>

<style>
  .nl-wrap {
    max-width: 560px;
  }

  .nl-embed {
    min-height: 120px;
  }

  .nl-note {
    font-size: 0.8rem;
    margin-top: 0.6rem;
    opacity: 0.75;
  }
</style>
