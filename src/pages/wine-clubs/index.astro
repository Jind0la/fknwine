---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const clubs = (await getCollection('clubs')).sort((a, b) => a.data.order - b.data.order);

// Sammelseite: die Hub-Seite ist der Einstieg für "wine club reviews" —
// CollectionPage + ItemList, damit Suchmaschinen die 6 Einzel-Reviews als
// geordnete Liste verstehen (SEO-Audit 22.10.2026).
const collectionSchema = {
  '@type': 'CollectionPage',
  '@id': 'https://fknwine.com/wine-clubs/#collection',
  name: 'Wine Club Reviews',
  description:
    'Wine club reviews built on the paperwork: real price per bottle after the intro, commitment, cancel terms and shipping.',
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: clubs.length,
    itemListElement: clubs.map((club, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${club.data.name} review`,
      url: `https://fknwine.com/wine-clubs/${club.id}/`,
    })),
  },
};
---

<Layout
  title="Wine Club Reviews: 6 Clubs, Judged"
  description="Wine club reviews built from the paperwork: real price per bottle after the intro, commitment, cancel terms, shipping. Six clubs, checked by hand."
  breadcrumb={[
    { name: 'Home', url: '/' },
    { name: 'Wine Club Reviews', url: '/wine-clubs/' },
  ]}
  articleSchema={collectionSchema}
>
  <section class="wrapper" style="padding-top: 3rem; padding-bottom: 4rem;">
    <h1 style="font-size: clamp(2rem, 6vw, 3rem);">Wine club reviews, judged</h1>
    <p style="max-width: 660px;">
      These wine club reviews live and die on one number: the price per bottle <em>after</em> the
      intro offer. We read the fine print on every club — price, commitment, cancel terms,
      shipping — and print it here. No tasting theatrics, no "exclusive" nonsense. Just what it
      actually costs.
    </p>

    <div class="compare-wrap brutal-card" style="margin-top: 2rem;">
      <h2 class="compare-title">All six, side by side</h2>
      <div class="compare-scroll">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">Club</th>
              <th scope="col">First shipment</th>
              <th scope="col">Per bottle</th>
              <th scope="col">Commitment</th>
            </tr>
          </thead>
          <tbody>
            {
              clubs.map((club) => (
                <tr>
                  <th scope="row">
                    <a href={`/wine-clubs/${club.id}/`}>{club.data.name}</a>
                  </th>
                  <td>{club.data.priceFrom}</td>
                  <td>{club.data.perBottle}</td>
                  <td>{club.data.commitment}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="compare-note">
        Every figure above comes from the club's own site or help centre — each review carries the
        date we last checked it. We have not bought from all of them, and the reviews say so.
      </p>
    </div>

    <h2 style="margin-top: 3rem; font-size: 1.5rem;">The full reviews</h2>
    <div class="clubs-list">
      {
        clubs.map((club) => (
          <a href={`/wine-clubs/${club.id}/`} class="brutal-card brutal-shadow-hover club-card">
            <div class="club-top">
              <span class="verdict-chip">{club.data.verdictLabel}</span>
              <span class="club-price">{club.data.priceFrom}</span>
            </div>
            <h2>{club.data.name}</h2>
            <p>{club.data.summary}</p>
            <div class="club-facts">
              <span>
                <strong>Per bottle:</strong> {club.data.perBottle}
              </span>
              <span>
                <strong>Commitment:</strong> {club.data.commitment}
              </span>
            </div>
            <span class="teaser-more">Read the full review →</span>
          </a>
        ))
      }
    </div>

    <div class="brutal-card" style="margin-top: 2.5rem; max-width: 700px;">
      <h2 style="font-size: 1.2rem; margin-top: 0;">Why so few reviews?</h2>
      <p style="margin: 0; font-size: 0.9rem;">
        Because we check the terms on the merchant's own site before publishing — and we re-check
        before every update. More clubs are in the queue (Wine Insiders, WSJ Wine, Plonk).
        We publish when the paperwork is done, not before.
      </p>
    </div>
  </section>
</Layout>

<style>
  .compare-wrap {
    max-width: 1000px;
    padding: 1.25rem;
  }

  .compare-title {
    margin: 0 0 1rem;
    font-size: 1.1rem;
  }

  .compare-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .compare-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .compare-table th,
  .compare-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .compare-table thead th {
    font-family: var(--font-display);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
    white-space: nowrap;
  }

  .compare-table tbody th {
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .compare-table a {
    color: inherit;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 3px;
  }

  .compare-note {
    margin: 0.9rem 0 0;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .clubs-list {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .club-card {
    display: block;
    text-decoration: none;
    color: inherit;
    max-width: 760px;
  }

  .club-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .verdict-chip {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.6rem;
    background: var(--color-cta);
    color: var(--color-bg);
  }

  .club-price {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .club-card h2 {
    margin: 0 0 0.4rem;
    font-size: 1.4rem;
  }

  .club-card p {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }

  .club-facts {
    display: grid;
    gap: 0.25rem;
    font-size: 0.85rem;
    margin-bottom: 0.9rem;
    opacity: 0.85;
  }

  .teaser-more {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-cta);
  }
</style>
