---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { outUrl, merchants } from '../../data/merchants';

export async function getStaticPaths() {
  const clubs = await getCollection('clubs');
  return clubs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const siteUrl = (Astro.site ?? new URL('https://fknwine.com')).origin;
const pageUrl = `${siteUrl}/wine-clubs/${entry.id}/`;

// Autor/Publisher/Bild setzt das Layout zentral über @id-Referenzen
// (SEO-Audit 17.10.2026: vorher stand die Organization dreimal ohne @id
// auf jeder Artikelseite, und Article hatte kein image).
const articleSchema = {
  '@type': 'Article',
  headline: `${data.name} review: the fine print, checked`,
  description: data.summary,
  url: pageUrl,
  datePublished: data.lastChecked,
  dateModified: data.lastChecked,
  inLanguage: 'en',
};

const merchant = data.merchantId ? merchants[data.merchantId] : null;
const ctaUrl = data.merchantId ? outUrl(data.merchantId) : null;

// Meta-Beschreibung: bewusst aus den harten Fakten gebaut statt die (lange)
// summary zu nehmen — die lief bei sechs Seiten über Googles Anzeigegrenze.
const metaDescription = `${data.name} reviewed from the paperwork: ${data.priceFrom}, ${data.perBottle}. Commitment, cancel terms and shipping — checked ${data.lastChecked}.`;

const breadcrumb = [
  { name: 'Home', url: '/' },
  { name: 'Wine clubs, judged', url: '/wine-clubs/' },
  { name: data.name, url: `/wine-clubs/${entry.id}/` },
];

// Interne Verlinkung: die 9 Spokes waren vorher Sackgassen (Cluster-Audit).
const allClubs = await getCollection('clubs');
const siblings = allClubs
  .filter((club) => club.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const relatedGuides = [
  {
    href: '/guides/wine-club-price-per-bottle/',
    label: 'What six wine clubs really cost per bottle',
  },
  { href: '/guides/how-to-cancel-a-wine-club/', label: 'How to actually cancel a wine club' },
  // Neue Long-Tail-Guides (SEO-Audit 22.10.2026): interne Verlinkung von jeder
  // Review aus, damit die Cluster-Seiten nicht allein auf der Sitemap stehen.
  { href: '/guides/cheap-wine-clubs/', label: 'Cheap wine clubs: the real cost per bottle' },
  { href: '/guides/wine-club-for-beginners/', label: 'First club? The 5-minute check' },
  { href: '/how-we-test/', label: 'How we test a wine club (our method)' },
];

const facts: Array<[string, string]> = [
  ['Price', data.priceFrom],
  ['Per bottle', data.perBottle],
  ['Commitment', data.commitment],
  ['Cancellation', data.cancelTerms],
  ['Ships to', data.shipsTo],
];
---

<Layout
  title={data.seoTitle ?? `${data.name} review, checked`}
  description={metaDescription}
  publishedTime={data.lastChecked}
  modifiedTime={data.lastChecked}
  articleSchema={articleSchema}
  breadcrumb={breadcrumb}
>
  <article class="wrapper" style="padding-top: 3rem; padding-bottom: 4rem; max-width: 800px;">
    <a href="/wine-clubs/" class="back-link">← All club reviews</a>

    <header style="margin-top: 1.5rem;">
      <div class="review-top">
        <span class="verdict-chip">{data.verdictLabel}</span>
        <span class="checked-note">
          Checked <time datetime={data.lastChecked}>{data.lastChecked}</time>
        </span>
      </div>
      <h1 style="font-size: clamp(2rem, 6vw, 3rem); margin: 0.75rem 0 0.5rem;">{data.name}</h1>
      <p style="font-size: 1.1rem; margin: 0;">{data.summary}</p>
    </header>

    {/*
      GEO-Block (22.10.2026): eine in sich geschlossene Antwortzeile mit den drei
      Zahlen, nach denen gefragt wird. KI-Suche (ChatGPT, Perplexity, Copilot)
      zitiert bevorzugt einen vollständigen Satz statt einer Tabelle — deshalb
      Satzform und nicht nur dl. Werte kommen unverändert aus der Frontmatter,
      es wird nichts umformuliert oder geschätzt.
    */}
    <section class="answer-box" aria-label="Short answer">
      <p class="answer-label">Short answer</p>
      <p class="answer-text">
        <strong>{data.verdictLabel}.</strong>
        {' '}{data.priceFrom}. {data.perBottle}.
      </p>
    </section>

    <!-- === QUICK FACTS === -->
    <section class="brutal-card facts-box">
      <h2 style="font-size: 1.1rem; margin-top: 0;">
        The facts (as of <time datetime={data.lastChecked}>{data.lastChecked}</time>)
      </h2>
      <dl class="facts-list">
        {
          facts.map(([label, value]) => (
            <div class="fact-row">
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- === PROS / CONS === -->
    <section class="proscons">
      <div class="brutal-card pros-box">
        <h2 style="font-size: 1.1rem; margin-top: 0;">Worth it because</h2>
        <ul>
          {data.pros.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <div class="brutal-card cons-box">
        <h2 style="font-size: 1.1rem; margin-top: 0;">But know this</h2>
        <ul>
          {data.cons.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <!-- === CONTENT === -->
    <section class="article-content" style="margin-top: 2.5rem;">
      <Content />
    </section>

    <!-- === RELATED (interne Verlinkung) === -->
    <section class="related">
      <div class="brutal-card related-box">
        <h2 style="font-size: 1.1rem; margin-top: 0;">Compare before you buy</h2>
        <ul>
          {relatedGuides.map((guide) => (
            <li>
              <a href={guide.href}>{guide.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="brutal-card related-box">
        <h2 style="font-size: 1.1rem; margin-top: 0;">Other clubs we read the fine print on</h2>
        <ul>
          {siblings.map((club) => (
            <li>
              <a href={`/wine-clubs/${club.id}/`}>
                {club.data.name} — {club.data.priceFrom}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- === CTA === -->
    {
      ctaUrl && merchant && (
        <section class="brutal-card cta-box">
          <h2 style="font-size: 1.2rem; margin-top: 0;">Try it yourself</h2>
          <p style="font-size: 0.95rem;">
            {data.priceFrom}. Everything above is from {merchant.name}'s own site — verify the
            terms at checkout before you pay.
          </p>
          <a class="brutal-btn" href={ctaUrl} target="_blank" rel="noopener nofollow">
            Go to {merchant.name} →
          </a>
          <p class="cta-small">
            Link goes to {merchant.name}. See how we handle links on our <a href="/disclosure/">disclosure page</a>.
          </p>
        </section>
      )
    }
  </article>
</Layout>

<style>
  .back-link {
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }

  .back-link:hover {
    color: var(--color-cta);
  }

  .review-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .verdict-chip {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.7rem;
    background: var(--color-cta);
    color: var(--color-bg);
  }

  .checked-note {
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .answer-box {
    margin-top: 1.75rem;
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--color-cta);
    background: rgba(255, 255, 255, 0.03);
    max-width: 760px;
  }

  .answer-label {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-cta);
  }

  .answer-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .facts-box {
    margin-top: 2rem;
  }

  .facts-list {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .fact-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-fkn-gray);
  }

  .fact-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .fact-row dt {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-cta);
  }

  .fact-row dd {
    margin: 0;
    font-size: 0.92rem;
  }

  .proscons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .pros-box {
    border-color: #4caf50;
  }

  .cons-box {
    border-color: var(--color-primary);
  }

  .pros-box ul,
  .cons-box ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .pros-box li,
  .cons-box li {
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .related {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .related-box ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .related-box li {
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .related-box a {
    color: var(--color-cta);
  }

  .cta-box {
    margin-top: 2.5rem;
    border-color: var(--color-cta);
    box-shadow: 6px 6px 0 0 var(--color-cta);
  }

  .cta-small {
    font-size: 0.78rem;
    opacity: 0.6;
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  @media (max-width: 520px) {
    .fact-row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
