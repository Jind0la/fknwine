---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DealCard from '../../components/DealCard.astro';
import { deals } from '../../data/deals';

// Die Deals-Seite verlinkte früher direkt zu den Merchants und nie zu einer
// Club-Review — Cluster-Audit 17.10.2026: Sackgasse + Link-Equity-Leak.
const clubs = (await getCollection('clubs')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Wine club deals & intro offers, checked"
  description="Wine club deals and intro offers we've checked by hand: first-box prices, flash sales, promo codes. Dates and fine print included."
  breadcrumb={[
    { name: 'Home', url: '/' },
    { name: 'Wine Club Deals', url: '/deals/' },
  ]}
>
  <section class="wrapper" style="padding-top: 3rem; padding-bottom: 4rem;">
    <h1 style="font-size: clamp(2rem, 6vw, 3rem);">Wine club deals, checked</h1>
    <p style="max-width: 640px;">
      Every wine club deal and intro offer on this page was checked by hand on the date shown.
      These offers expire fast — if a price is gone, it's gone. That's why we print the date.
    </p>

    <div class="deals-grid" style="margin-top: 2rem;">
      {deals.map((deal) => <DealCard deal={deal} />)}
    </div>

    <div class="brutal-card" style="margin-top: 2.5rem; max-width: 700px;">
      <h2 style="font-size: 1.2rem; margin-top: 0;">Not sure a club is worth joining?</h2>
      <p style="font-size: 0.9rem;">
        Intro offers are the easy part. Before you subscribe anywhere, read what the club actually
        charges per bottle after the intro — and how you get out again:
      </p>
      <ul style="font-size: 0.9rem; padding-left: 1.2rem; margin-bottom: 0.75rem;">
        {clubs.map((club) => (
          <li>
            <a href={`/wine-clubs/${club.id}/`}>
              {club.data.name} — {club.data.perBottle}
            </a>
          </li>
        ))}
      </ul>
      <p style="margin: 0; font-size: 0.9rem;">
        <a href="/guides/wine-club-price-per-bottle/">All six clubs, side by side →</a>
      </p>
    </div>

    <div class="brutal-card" style="margin-top: 1.5rem; max-width: 700px;">
      <h2 style="font-size: 1.2rem; margin-top: 0;">How this page works</h2>
      <p style="margin: 0; font-size: 0.9rem;">
        We only list deals we can verify on the merchant's own site — no "up to 70% off" marketing
        math. Flash-sale prices (like WTSO) can change within hours; promo codes have expiry dates.
        When a deal dies, it comes off the page. Want them in your inbox instead?
        <a href="/#newsletter">Join the Deal Sheet.</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .deals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
</style>
