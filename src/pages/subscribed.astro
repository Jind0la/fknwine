---
import Layout from '../layouts/Layout.astro';
---

<Layout title="You're in" description="You're on the FKN Wine Deal Sheet.">
  <section class="wrapper" style="padding-top: 4rem; padding-bottom: 4rem; max-width: 640px;">
    <h1 style="font-size: clamp(2rem, 6vw, 3rem);">You're in.</h1>
    <p style="font-size: 1.1rem;">
      Your spot on the <strong>Deal Sheet</strong> is confirmed. First drop lands this week —
      the best deals we found, plus one bottle worth your money.
    </p>
    <p>
      Zero spam, unsubscribe anytime. Deal?
    </p>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem;">
      <a href="/deals/" class="brutal-btn">See today's deals →</a>
      <a href="/" class="brutal-btn brutal-btn--inverse">Back to the start</a>
    </div>
  </section>
</Layout>
