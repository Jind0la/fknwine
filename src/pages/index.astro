---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DealCard from '../components/DealCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { deals } from '../data/deals';

const clubs = (await getCollection('clubs'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 1);

const topDeals = deals.slice(0, 4);
---

<Layout
  title="Wine Deals, Judged Honestly"
  description="Great wine doesn't have to cost $40. We hunt the deals, read the fine print, and tell you what's actually worth your money — no sommelier act, no fake reviews."
>
  <!-- === HERO === -->
  <section class="wrapper hero">
    <div class="hero-inner">
      <span class="hero-eyebrow">No snobs. No bullshit. No fake reviews.</span>

      <h1>
        F*CK
        <br />
        NICE
        <br />
        <span style="color: var(--color-primary);">WINE</span>
      </h1>

      <p class="hero-sub">
        Great wine doesn't have to cost $40. And you don't need a sommelier certification to find
        it. We hunt the deals, read the fine print, and tell you what's actually worth your
        money.
      </p>

      <div class="hero-ctas">
        <a href="/deals/" class="brutal-btn">See today's deals →</a>
        <a href="/wine-clubs/" class="brutal-btn brutal-btn--inverse">Wine clubs, judged →</a>
      </div>

      <p class="hero-note">
        Every deal on this site is checked by hand. Dates included — so you know how fresh it is.
      </p>
    </div>
  </section>

  <!-- === TRUST STRIP === -->
  <section class="wrapper" style="padding-bottom: 3rem;">
    <div class="trust-grid">
      <div class="brutal-card trust-card">
        <h2 class="trust-title">We check the fine print</h2>
        <p>Intro prices, auto-renewals, shipping states, cancel terms. We read it so you don't have to.</p>
      </div>
      <div class="brutal-card trust-card">
        <h2 class="trust-title">We don't fake reviews</h2>
        <p>No made-up tastings, no "notes of wet slate" — and when we haven't checked something, we say so. Opinions stay marked as opinions.</p>
      </div>
      <div class="brutal-card trust-card">
        <h2 class="trust-title">We'll tell you to skip it</h2>
        <p>If something isn't worth your money, we say so — and tell you what's better.</p>
      </div>
    </div>
  </section>

  <!-- === DEALS === -->
  <section class="wrapper" style="padding-bottom: 3rem;">
    <div class="section-head">
      <h2>Live deals</h2>
      <span class="section-note">Checked by hand. Updated as they change.</span>
    </div>

    <div class="deals-grid">
      {topDeals.map((deal) => <DealCard deal={deal} />)}
    </div>

    <div style="margin-top: 1.5rem;">
      <a href="/deals/" class="brutal-btn brutal-btn--inverse">All deals →</a>
    </div>
  </section>

  <!-- === CLUBS === -->
  <section class="wrapper" style="padding-bottom: 3rem;">
    <div class="section-head">
      <h2>Wine clubs, judged</h2>
      <span class="section-note">The paperwork, not the landing page.</span>
    </div>

    {
      clubs.map((club) => (
        <a href={`/wine-clubs/${club.id}/`} class="club-teaser brutal-card brutal-shadow-hover">
          <div class="club-teaser-top">
            <span class="verdict-chip">{club.data.verdictLabel}</span>
            <span class="club-price">{club.data.priceFrom}</span>
          </div>
          <h3>{club.data.name}</h3>
          <p>{club.data.summary}</p>
          <span class="teaser-more">Read the full review →</span>
        </a>
      ))
    }

    <div style="margin-top: 1.5rem;">
      <a href="/wine-clubs/" class="brutal-btn brutal-btn--inverse">All club reviews →</a>
    </div>
  </section>

  <!-- === NEWSLETTER === -->
  <section id="newsletter" class="wrapper" style="padding-bottom: 3rem;">
    <div class="newsletter-box">
      <h2>The Deal Sheet</h2>
      <p class="newsletter-sub">
        One email. The best wine deals we found this week + one bottle worth your money.
        No spam, unsubscribe anytime.
      </p>
      <NewsletterForm />
    </div>
  </section>

  <!-- === ABOUT TEASER === -->
  <section class="wrapper" style="padding-bottom: 4rem;">
    <div class="brutal-card" style="max-width: 700px;">
      <h2 style="font-size: 1.5rem; margin-top: 0;">What is FKN Wine?</h2>
      <p>
        We're not sommeliers and we don't play one on the internet. We're the site that tells you
        which wine deal is actually good, which club deserves your money, and which $15 bottle
        beats the $40 one — with the fine print included.
      </p>
      <a href="/about/" class="brutal-btn" style="font-size: 0.8rem; padding: 0.5rem 1rem;">How we work →</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .hero-inner {
    display: grid;
    gap: 1rem;
    max-width: 800px;
  }

  .hero-eyebrow {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-primary);
    color: var(--color-fkn-white);
    width: fit-content;
  }

  .hero-sub {
    font-size: 1.2rem;
    max-width: 640px;
    margin-top: 0.5rem;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .hero-note {
    font-size: 0.85rem;
    opacity: 0.65;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .trust-card h2.trust-title {
    font-size: 1rem;
    margin: 0 0 0.5rem;
    color: var(--color-cta);
  }

  .trust-card p {
    font-size: 0.9rem;
    margin: 0;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .section-head h2 {
    margin: 0;
    font-size: 1.75rem;
  }

  .section-note {
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
  }

  .deals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .club-teaser {
    display: block;
    text-decoration: none;
    color: inherit;
    max-width: 700px;
  }

  .club-teaser-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .verdict-chip {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.6rem;
    background: var(--color-cta);
    color: var(--color-bg);
  }

  .club-price {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .club-teaser h3 {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
  }

  .club-teaser p {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }

  .teaser-more {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-cta);
  }

  .newsletter-box {
    border: 3px solid var(--color-cta);
    box-shadow: 6px 6px 0 0 var(--color-cta);
    padding: 2rem;
    max-width: 640px;
    margin: 0 auto;
  }

  .newsletter-box h2 {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
  }

  .newsletter-sub {
    margin: 0 0 1rem;
  }
</style>
